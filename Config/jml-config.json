  "policies": {
    "provisioning": {
      "engine": "PowerShell + Microsoft Graph",
      "script": "phases/01-jml-lifecycle/Invoke-HRSync.ps1",
      "matchOrder": [
        "employeeId",
        "userPrincipalName"
      ],
      "writePasswordsToDisk": false,
      "neverDisableOrDelete": true
    },
    "lifecycleWorkflows": [
      {
        "name": "LCW-Joiner-PreHire",
        "template": "Onboard pre-hire employee",
        "trigger": "employeeHireDate",
        "offsetDays": -3
      },
      {
        "name": "LCW-Joiner-DayOne",
        "template": "Onboard new hire employee",
        "trigger": "employeeHireDate",
        "offsetDays": 0
      },
      {
        "name": "LCW-Mover",
        "template": "Employee job profile change",
        "trigger": "attributeChange",
        "attributes": [
          "department",
          "jobTitle"
        ]
      },
      {
        "name": "LCW-Leaver-LastDay",
        "template": "Offboard an employee",
        "trigger": "employeeLeaveDateTime",
        "offsetDays": 0
      },
      {
        "name": "LCW-Leaver-Post",
        "template": "Post-offboarding of an employee",
        "trigger": "employeeLeaveDateTime",
        "offsetDays": 30
      }
    ]
  },
  "emergencyAccess": {
    "upnPrefix": "bg-emergency",
    "count": 2,
    "excludeFromConditionalAccess": true
  },
  "logging": {
    "path": "logs",
    "format": "csv",
    "includePasswords": false
  },
  "externalApps": {
    "salesforce": {
      "edition": "Developer Edition",
      "myDomainUrl": "<set in Phase 00>",
      "protocol": "SAML",
      "provisioning": "SCIM (optional, pilot set)",
      "groups": {
        "GRP-APP-Salesforce-Users": [
          "Account Manager",
          "Inside Sales Specialist",
          "Sales Development Associate"
        ],
        "GRP-APP-Salesforce-Managers": [
          "Sales Team Lead",
          "Sales Director",
          "VP of Sales"
        ],
        "GRP-APP-Salesforce-Admins": [
          "Sales Operations Analyst"
        ],
        "GRP-APP-Salesforce-ReadOnly": [
          "Chief Revenue Officer",
          "Chief Executive Officer",
          "FP&A Analyst"
        ]
      }
    },
    "okta": {
      "plan": "Integrator Free Plan",
      "orgUrl": "<set in Phase 00>",
      "pattern": "Entra ID as external IdP for Okta",
      "protocol": "OIDC or SAML",
      "jitAttributes": [
        "department",
        "jobTitle",
        "employeeId"
      ],
      "groups": [
        "GRP-APP-Okta-Users"
      ]
    }
  },
